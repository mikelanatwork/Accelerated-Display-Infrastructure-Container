<user-mapping>
  <authorize username="ereshkigal" password="ereshkigal">
    <connection name="Ubuntu Desktop">
      <protocol>rdp</protocol>
      <param name="hostname">ereshkigal</param>
      <param name="port">3389</param>
      <param name="username">ereshkigal</param>
      <param name="password">ereshkigal</param>
      <param name="security">any</param>
      <param name="ignore-cert">true</param>
